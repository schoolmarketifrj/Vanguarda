rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'clx@gmail.com';
    }

    function isEditor() {
      return request.auth != null
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/siteEditors/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/siteEditors/$(request.auth.token.email.lower())).data.active == true;
    }

    function canManageContent() {
      return isAdmin() || isEditor();
    }

    function validEditor(data, email) {
      return data.keys().hasAll(['email', 'active', 'createdAt'])
        && data.keys().hasOnly(['email', 'active', 'createdAt'])
        && data.email == email
        && data.active is bool
        && data.createdAt is timestamp;
    }

    function validContent(data) {
      return data.keys().hasAll(['title', 'description', 'type', 'url', 'updatedAt', 'createdAt'])
        && data.keys().hasOnly(['title', 'description', 'type', 'url', 'updatedAt', 'createdAt'])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 100
        && data.description is string
        && data.description.size() <= 300
        && data.type in ['complaint', 'anonymous', 'suggestion', 'resource', 'email', 'event']
        && data.url is string
        && data.url.size() <= 2048
        && data.updatedAt is timestamp
        && data.createdAt is timestamp
        && (
          data.url.matches('https?://.*')
          || data.url.matches('mailto:.*')
          || (data.type == 'event' && data.url == '')
        );
    }

    match /siteContent/{contentId} {
      allow read: if true;
      allow create: if canManageContent() && validContent(request.resource.data);
      allow update: if canManageContent()
        && validContent(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if canManageContent();
    }

    match /siteEditors/{email} {
      allow get: if isAdmin()
        || (request.auth != null
          && request.auth.token.email is string
          && request.auth.token.email.lower() == email
          && resource.data.active == true);
      allow list: if isAdmin();
      allow create, update: if isAdmin() && validEditor(request.resource.data, email);
      allow delete: if isAdmin();
    }
  }
}
